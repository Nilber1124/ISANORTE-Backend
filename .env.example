# ============================================================
# .env.example — Plantilla para desarrollo local
# Copia este archivo a .env y rellena los valores reales.
# El archivo .env NUNCA debe commitearse al repositorio.
# ============================================================

# ---- Servidor ----
PORT=8080

# ---- Base de datos ----
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/isanorte_db
SPRING_DATASOURCE_USERNAME=isanorte_user
SPRING_DATASOURCE_PASSWORD=

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# ---- JWT ----
JWT_SECRET=
JWT_EXPIRATION=PT8H

# ---- Administrador inicial ----
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Seed de demo (solo desarrollo) ----
SEED_DEMO_PRODUCTS=false
